# ——— Configuration d'environnement ———
# Copier ce fichier en `.env` et renseigner les valeurs.

# URL canonique du site en production (sans slash final).
# Utilisée pour les canonicals, le sitemap, les métadonnées sociales.
SITE_URL=https://www.votre-domaine.fr

# Endpoint de réception du formulaire de contact (POST JSON).
# Compatible avec Formspree, Basin, un worker maison, etc.
# Si vide : le formulaire propose un envoi par email (mailto) en solution de repli.
PUBLIC_FORM_ENDPOINT=

# Hôte d'un outil d'analytics respectueux de la vie privée (ex. Plausible auto-hébergé).
# Si vide : aucun script de mesure n'est chargé. Aucun cookie n'est déposé dans tous les cas.
PUBLIC_ANALYTICS_HOST=

# Domaine déclaré auprès de l'outil d'analytics (ex. votre-domaine.fr).
PUBLIC_ANALYTICS_DOMAIN=

# Jeton de vérification Google Search Console (balise meta). Optionnel.
PUBLIC_GSC_VERIFICATION=
