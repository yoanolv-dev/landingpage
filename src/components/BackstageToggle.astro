---
/**
 * « Mode coulisses » — la signature du site.
 * Un bouton flottant révèle le calque d'annotations de conception :
 * la page explique ses propres décisions, comme un document de travail.
 */
---

<div class="backstage-toggle">
  <button type="button" id="backstage-btn" aria-pressed="false" data-track="mode-coulisses">
    <span class="asterisk" aria-hidden="true">✳</span>
    <span class="backstage-label">Voir les coulisses</span>
  </button>
  <p class="backstage-hint" id="backstage-hint" hidden>
    Les notes vermillon expliquent les décisions de conception de cette page.
  </p>
</div>

<style>
  .backstage-toggle {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    display: grid;
    gap: var(--space-2);
    max-width: 16rem;
    justify-items: end;
  }

  #backstage-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
    border-radius: 999px;
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.5);
    cursor: pointer;
    transition: background var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  #backstage-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  #backstage-btn[aria-pressed='true'] {
    background: var(--vermillon-ink);
    border-color: var(--vermillon-ink);
    color: var(--paper);
  }

  #backstage-btn[aria-pressed='true'] .asterisk {
    color: var(--paper);
  }

  .backstage-hint {
    margin: 0;
    padding: var(--space-3);
    font-size: var(--text-xs);
    font-style: italic;
    background: var(--paper);
    border: var(--hairline);
    border-left: 2px solid var(--vermillon);
    color: var(--vermillon-ink);
  }

  @media (max-width: 40rem) {
    .backstage-label {
      display: none;
    }

    #backstage-btn {
      padding: 0.7em;
    }

    #backstage-btn .asterisk {
      font-size: 1.1rem;
    }
  }

  @media print {
    .backstage-toggle {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('backstage-btn') as HTMLButtonElement;
  const hint = document.getElementById('backstage-hint') as HTMLElement;
  const root = document.documentElement;

  function setBackstage(on: boolean) {
    root.dataset.backstage = String(on);
    btn.setAttribute('aria-pressed', String(on));
    const label = btn.querySelector('.backstage-label');
    if (label) label.textContent = on ? 'Masquer les coulisses' : 'Voir les coulisses';
    hint.hidden = !on;
    try {
      sessionStorage.setItem('backstage', String(on));
    } catch {
      /* stockage indisponible : le mode reste fonctionnel sans persistance */
    }
  }

  btn.addEventListener('click', () => {
    setBackstage(root.dataset.backstage !== 'true');
  });

  try {
    if (sessionStorage.getItem('backstage') === 'true') setBackstage(true);
  } catch {
    /* ignore */
  }
</script>
