---
import { site } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
  label?: string;
  href?: string;
  note?: string;
  track?: string;
}

const {
  title = 'Parlons de votre page',
  text = `Décrivez votre offre et votre objectif en quelques lignes. Vous recevez une ${site.commitments.responseTime.replace('réponse ', 'réponse argumentée ')}, avec un premier avis honnête — y compris si une landing page n'est pas la bonne réponse.`,
  label = site.cta.label,
  href = site.cta.href,
  note = `Sans engagement — ${site.commitments.responseTime}.`,
  track = 'cta-bande',
} = Astro.props;
---

<section class="cta-band band--ink" aria-labelledby="cta-band-title">
  <div class="container cta-inner">
    <div>
      <h2 id="cta-band-title" set:html={title} />
      <p class="lede">{text}</p>
    </div>
    <div class="cta-action">
      <a href={href} class="btn" data-track={track}>
        {label} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <p class="btn-note">{note}</p>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .cta-inner h2 {
    font-size: var(--text-3xl);
  }

  .cta-action {
    justify-self: end;
    text-align: left;
  }

  @media (max-width: 56rem) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .cta-action {
      justify-self: start;
    }
  }
</style>
