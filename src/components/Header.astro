---
import { site } from '@/config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.brand} — accueil`}>
      {site.brand}<span class="asterisk" aria-hidden="true">✳</span>
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul class="list-plain">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={site.cta.href} class="btn btn--header" data-track="cta-header">
      {site.cta.label}
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="menu-toggle-label">Menu</span>
    </button>
  </div>

  <nav class="nav-mobile" id="menu-mobile" aria-label="Navigation mobile" hidden>
    <ul class="list-plain">
      {
        site.nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="nav-mobile-no mono" aria-hidden="true">
                0{i + 1}
              </span>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="nav-mobile-action" style={`--i: ${site.nav.length}`}>
        <a href={site.cta.href} class="btn" data-track="cta-header">
          {site.cta.label} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4.25rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 96;
    text-decoration: none;
    margin-right: auto;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand .asterisk {
    display: inline-block;
    margin-left: 0.06em;
    text-shadow: 0 0 14px rgb(255 74 31 / 0.8);
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-8);
  }

  .nav-desktop a {
    position: relative;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 560;
    color: var(--ink-soft);
    padding-block: var(--space-2);
    transition: color var(--speed) var(--ease);
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--vermillon);
    box-shadow: 0 0 10px rgb(255 74 31 / 0.7);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--speed) var(--ease);
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .btn--header {
    font-size: var(--text-sm);
    padding: 0.65em 1.3em;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    border-radius: var(--radius-pill);
    padding: 0.5em 1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-label::after {
    content: ' ✕';
    color: var(--vermillon-ink);
  }

  .nav-mobile {
    display: none;
    border-top: var(--hairline);
    background: var(--paper);
    min-height: calc(100dvh - 4.25rem);
  }

  .nav-mobile ul {
    display: grid;
    padding: var(--space-6) var(--gutter) var(--space-12);
  }

  .nav-mobile a:not(.btn) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: var(--hairline);
  }

  .nav-mobile-no {
    font-size: var(--text-xs);
    color: var(--vermillon-ink);
    letter-spacing: 0.14em;
  }

  .nav-mobile a[aria-current='page']:not(.btn) {
    color: var(--vermillon-ink);
  }

  .nav-mobile-action {
    margin-top: var(--space-8);
  }

  .nav-mobile-action .btn {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-mobile:not([hidden]) li {
      opacity: 0;
      translate: 0 14px;
      animation: rise 420ms var(--ease) forwards;
      animation-delay: calc(var(--i, 0) * 60ms);
    }
  }

  @media (max-width: 56rem) {
    .nav-desktop,
    .btn--header {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .nav-mobile:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-mobile');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    document.documentElement.style.overflow = open ? '' : 'hidden';
  });
</script>
