---
import { site } from '@/config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.brand} — accueil`}>
      {site.brand}<span class="asterisk" aria-hidden="true">✳</span>
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul class="list-plain">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={site.cta.href} class="btn btn--header" data-track="cta-header">
      {site.cta.label}
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="menu-toggle-label">Menu</span>
    </button>
  </div>

  <nav class="nav-mobile" id="menu-mobile" aria-label="Navigation mobile" hidden>
    <ul class="list-plain">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={site.cta.href} class="nav-mobile-cta" data-track="cta-header">
          {site.cta.label} →
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }

  .brand:hover {
    color: var(--ink);
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-6);
  }

  .nav-desktop a {
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 480;
    padding-block: var(--space-2);
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    color: var(--vermillon-ink);
    text-decoration: underline;
    text-decoration-color: var(--vermillon);
    text-underline-offset: 0.4em;
  }

  .btn--header {
    font-size: var(--text-sm);
    padding: 0.6em 1.1em;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    padding: 0.45em 0.9em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-label::after {
    content: ' ✕';
  }

  .nav-mobile {
    display: none;
    border-top: var(--hairline);
    background: var(--paper);
  }

  .nav-mobile ul {
    display: grid;
    padding: var(--space-4) var(--gutter) var(--space-8);
  }

  .nav-mobile a {
    display: block;
    padding: var(--space-4) 0;
    font-size: var(--text-lg);
    text-decoration: none;
    border-bottom: var(--hairline);
  }

  .nav-mobile a[aria-current='page'] {
    color: var(--vermillon-ink);
  }

  .nav-mobile-cta {
    font-weight: 600;
    color: var(--vermillon-ink);
  }

  @media (max-width: 56rem) {
    .nav-desktop,
    .btn--header {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .nav-mobile:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-mobile');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
